# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...

# The Document QA project whose retriever is evaluated (clone it next to this repo)
DOCQA_PATH=../document-qa-citations

# PostgreSQL with pgvector (each chunking config gets its own schema of Document QA tables)
#   In psql:  CREATE DATABASE retrieval_lab;  CREATE DATABASE retrieval_lab_test;
#             CREATE EXTENSION vector;   (in both)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/retrieval_lab
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/retrieval_lab_test

# Optional
AGENT_MODEL=claude-opus-5-5
VOYAGE_MODEL=voyage-3.5
EMBEDDING_DIM=1024
VOYAGE_RERANK_MODEL=rerank-2.5
# Fill in from your Voyage plan to get dollar figures in the cost column
VOYAGE_EMBED_PRICE_PER_MTOK=0
VOYAGE_RERANK_PRICE_PER_MTOK=0
LOG_LEVEL=INFO
